  <library_effects>
    <effect id="transparent-effect">
      <profile_COMMON>
        <newparam sid="texture_png-surface">
          <surface type="2D">
            <init_from>texture_png</init_from>
          </surface>
        </newparam>
        <newparam sid="texture_png-sampler">
          <sampler2D>
            <source>texture_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="texture_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <transparent opaque="A_ONE">
              <color sid="alpha">0 0 0 0.15</color>
            </transparent>
            <index_of_refraction>
              <float sid="ior">1</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
