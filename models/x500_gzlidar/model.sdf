<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_gzlidar'>
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Publish model odometry (pose + twist) for GT/VIO bridging -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>


    <link name="lidar_link">
      <pose relative_to="base_link">0 0 0.065 0 0 0</pose>
      <inertial>
        <mass>0.23</mass>
        <inertia>
          <ixx>0.0001618</ixx>
          <iyy>0.0001618</iyy>
          <izz>0.0001617</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.0375</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <sensor name='lidar' type='gpu_lidar'>
        <gz_frame_id>lidar_cloud</gz_frame_id>
        <topic>/lidar/cloud</topic>
        <update_rate>5</update_rate>
        <lidar>
            <scan>
                <horizontal>
                    <samples>563</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14159265359</min_angle>
                    <max_angle>3.14159265359</max_angle>
                </horizontal>
                <vertical>
                    <samples>18</samples>
                    <resolution>1</resolution>
                    <min_angle>0.0</min_angle>
                    <max_angle>1.57079632679</max_angle>
                </vertical>
            </scan>
            <range>
                <min>0.3</min>
                <max>30.0</max>
                <resolution>0.001</resolution>
            </range>
            <!--
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
            -->
        </lidar>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>

      <sensor name='imu' type='imu'>
        <gz_frame_id>lidar_imu</gz_frame_id>
        <topic>/lidar/imu</topic>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0009</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0009</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0009</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.006</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.006</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.006</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <always_on>1</always_on>
      </sensor>
    </link>



    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
  </model>
</sdf>
